# Environment variables for Nriju application
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/nriju
JWT_SECRET=replace_with_min_32_chars
JWT_REFRESH_SECRET=replace_with_min_32_chars
SALT=10

CLIENT_URL=http://localhost:5173

# GOOGLE OAUTH
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# PAYSTACK PAYMENT SETTINGS
PAYSTACK_SECRET_KEY=sk_test_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_paystack_public_key_here

# BREVO EMAIL SETTINGS
BREVO_API_KEY=your_brevo_api_key_here
EMAIL_FROM=orders@nriju.com
EMAIL_FROM_NAME=Nriju Store

# CLOUDINARY SETTINGS
CLOUDINARY_CLOUD_NAME=nriju
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret